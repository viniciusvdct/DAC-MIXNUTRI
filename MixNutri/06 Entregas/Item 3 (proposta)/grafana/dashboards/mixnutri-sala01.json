          "rawQuery": true,
          "rawSql": "SELECT inicio AS \"Início\", fim AS \"Fim\", round(duracao_s, 1) AS \"Duração (s)\", motivo_fim AS \"Motivo do fim\",\n       fonte_estado AS \"Fonte\", device_id AS \"Dispositivo\", produto AS \"Produto\", lote_producao AS \"Lote\",\n       referencia_tempo AS \"Referência de tempo\", observacao AS \"Observação\"\nFROM mixnutri.paradas_maquina_sala01\nWHERE inicio <= $__timeTo()::timestamptz AND coalesce(fim, 'infinity') >= $__timeFrom()::timestamptz\nORDER BY inicio DESC"
        }
