    {
        "id": "fn_sql",
        "type": "function",
        "z": "aba_mixnutri",
        "name": "Montar chamada SQL",
        "func": "// Monta a chamada parametrizada; so aceita funcoes conhecidas.\nconst permitidas = ['gravar_telemetria', 'gravar_parada_inicio', 'gravar_parada_fim', 'gravar_boot',\n    'gravar_sensor', 'gravar_config_aplicada', 'gravar_disponibilidade', 'registrar_somente'];\nif (!permitidas.includes(msg.funcao)) {\n    throw new Error('funcao nao permitida: ' + msg.funcao);\n}\nmsg.query = 'SELECT integracao.' + msg.funcao + '($1, $2::jsonb) AS resultado';\nmsg.params = [msg.topic, msg.texto];\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1190,
        "y": 240,
        "wires": [
            [
                "pg_gravar"
            ]
        ]
    },
    {
        "id": "pg_gravar",
        "type": "postgresql",
        "z": "aba_mixnutri",
        "name": "Gravar (funcoes integracao.*)",
        "query": "",
        "postgreSQLConfig": "pg_cfg",
        "split": false,
        "rowsPerMsg": 1,
        "outputs": 1,
        "x": 1420,
        "y": 240,
        "wires": [
            [
                "fn_resultado"
            ]
        ]
    },
    {
        "id": "fn_resultado",
        "type": "function",
        "z": "aba_mixnutri",
        "name": "Contar resultados",
        "func": "// Conta os resultados devolvidos pelas funcoes e mostra no status do no.\nconst r = (msg.payload && msg.payload[0] && msg.payload[0].resultado) || '?';\nconst n = (context.get('n') || 0) + 1;\nconst dup = (context.get('dup') || 0) + (r === 'duplicada' ? 1 : 0);\ncontext.set('n', n);\ncontext.set('dup', dup);\nnode.status({ fill: 'green', shape: 'dot', text: n + ' gravadas (' + dup + ' duplicadas)' });\nmsg.payload = { topico: msg.topic, funcao: msg.funcao, resultado: r };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1640,
        "y": 240,
        "wires": [
            [
                "dbg_resultado"
            ]
        ]
    },
