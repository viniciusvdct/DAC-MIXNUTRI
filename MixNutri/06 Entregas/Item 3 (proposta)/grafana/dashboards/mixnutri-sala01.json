          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(t.data_medicao, t.data_recebimento) AS \"time\",\n       t.umidade_pct AS \"Umidade (%UR)\",\n       t.temperatura_c AS \"Temperatura (°C)\",\n       c.ur_liga AS \"UR liga (config.)\",\n       c.ur_desliga AS \"UR desliga (config.)\"\nFROM mixnutri.telemetria_sala01 t\nLEFT JOIN mixnutri.configuracao_alertas c ON c.id = t.configuracao_id\nWHERE $__timeFilter(coalesce(t.data_medicao, t.data_recebimento))\nORDER BY 1"
        }
