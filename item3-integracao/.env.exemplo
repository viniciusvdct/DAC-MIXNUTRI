# MODELO sem senhas reais (publicado no repositorio). Copiar para .env e trocar cada TROCAR_*
# por uma senha forte. O .env fica fora do git.
# Credenciais de TESTE geradas em 27/10/2026 para o ambiente local da proposta do item 3.
# Somente localhost e dados sinteticos. Nao reutilizar em outro ambiente nem no broker/banco
# reais da equipe 2. Para usar: copiar este arquivo para .env (o .env fica fora do git).

# Mosquitto (sem acesso anonimo). Um usuario para o ESP32 e outro para o backend/Admin.
MQTT_ESP32_USUARIO=mixnutri_esp32
MQTT_ESP32_SENHA=TROCAR_mqtt_esp32_senha
MQTT_BACKEND_USUARIO=mixnutri_backend
MQTT_BACKEND_SENHA=TROCAR_mqtt_backend_senha

# PostgreSQL: administrador do banco e senhas dos papeis nodered_ingestao e grafana_leitura.
POSTGRES_USUARIO=mixnutri_admin
POSTGRES_SENHA=TROCAR_postgres_senha
PG_NODERED_SENHA=TROCAR_pg_nodered_senha
PG_GRAFANA_SENHA=TROCAR_pg_grafana_senha
# Porta no host (5432 costuma estar ocupada por um PostgreSQL local).
PG_PORTA_HOST=55432

# Editores web (somente em 127.0.0.1).
NODERED_ADMIN_USUARIO=admin_teste
NODERED_ADMIN_SENHA=TROCAR_nodered_admin_senha
GRAFANA_ADMIN_USUARIO=admin_teste
GRAFANA_ADMIN_SENHA=TROCAR_grafana_admin_senha

# Leitura Modbus TCP no Node-RED (opcional; acesso ao CLP nao autorizado). Com o simulador:
# MODBUS_HABILITADO=true e docker compose --profile modbus up -d. Registradores do mapa da outra equipe.
MODBUS_HABILITADO=false
MODBUS_HOST=modbus-sim
MODBUS_PORTA=5020
MODBUS_UNIT=1
MODBUS_REG_STATUS=3
MODBUS_REG_FALHA=5
MODBUS_INTERVALO_S=2
MODBUS_ORIGEM_DADOS=simulacao
