    {
      "id": 5,
      "type": "state-timeline",
      "title": "Linha do tempo de paradas (inferidas)",
      "description": "Linha 1: tabela paradas_maquina_sala01 (eventos PARADA_INICIO/FIM e fechamento por BOOT). Linha 2: estado amostrado na telemetria a cada 5 s, que pode não mostrar paradas curtas.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mixnutri-pg"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mixnutri-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \"time\", estado AS \"Paradas registradas\"\nFROM (\n  SELECT $__timeFrom()::timestamptz AS \"time\",\n         CASE WHEN EXISTS (SELECT 1 FROM mixnutri.paradas_maquina_sala01 p\n                           WHERE p.inicio <= $__timeFrom()::timestamptz\n                             AND coalesce(p.fim, 'infinity') > $__timeFrom()::timestamptz)\n              THEN 'PARADA' ELSE 'sem parada' END AS estado\n  UNION ALL\n  SELECT inicio, 'PARADA' FROM mixnutri.paradas_maquina_sala01\n   WHERE inicio > $__timeFrom()::timestamptz AND inicio <= $__timeTo()::timestamptz\n  UNION ALL\n  SELECT fim, 'sem parada' FROM mixnutri.paradas_maquina_sala01\n   WHERE fim > $__timeFrom()::timestamptz AND fim <= $__timeTo()::timestamptz\n) s\nORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mixnutri-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(t.data_medicao, t.data_recebimento) AS \"time\", t.estado_maquina AS \"Estado na telemetria (amostra de 5 s)\"\nFROM mixnutri.telemetria_sala01 t\nWHERE $__timeFilter(coalesce(t.data_medicao, t.data_recebimento))\nORDER BY 1"
        }
      ],
      "fieldConfig": {
