    {
        "id": "fn_falha",
        "type": "function",
        "z": "aba_mixnutri",
        "name": "Preparar registro de falha",
        "func": "// Erro na gravacao (restricao violada, campo ausente...) ou JSON invalido: guarda o texto e o motivo.\nconst motivo = msg.erro || (msg.error && msg.error.message) || String(msg.error || 'erro');\nconst n = (context.get('n') || 0) + 1;\ncontext.set('n', n);\nnode.status({ fill: 'red', shape: 'ring', text: n + ' falha(s)' });\nnode.warn('Falha ao gravar ' + msg.topic + ': ' + motivo);\nmsg.query = 'SELECT integracao.registrar_falha($1, $2, $3) AS resultado';\nmsg.params = [msg.topic, String(msg.texto !== undefined ? msg.texto : msg.payload), motivo];\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
