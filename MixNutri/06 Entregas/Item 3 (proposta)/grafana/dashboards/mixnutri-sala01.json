    {
      "id": 3,
      "type": "timeseries",
      "title": "Ruído em dBFS (relativo ao ADC) — não é dB SPL",
      "description": "dBFS = 20·log10(RMS_ADC/2048), sem calibração acústica. Não é nível de pressão sonora (dB SPL). Sinal sintético do chip de som do Wokwi.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "mixnutri-pg"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "mixnutri-pg"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT coalesce(t.data_medicao, t.data_recebimento) AS \"time\",\n       t.nivel_ruido AS \"Ruído (dBFS) — não é dB SPL\",\n       c.limiar_operando AS \"Limiar operando (dBFS)\",\n       c.limiar_parado AS \"Limiar parado (dBFS)\"\nFROM mixnutri.telemetria_sala01 t\nLEFT JOIN mixnutri.configuracao_alertas c ON c.id = t.configuracao_id\nWHERE $__timeFilter(coalesce(t.data_medicao, t.data_recebimento)) AND (t.unidade_ruido = 'dBFS' OR t.unidade_ruido IS NULL)\nORDER BY 1"
        }
