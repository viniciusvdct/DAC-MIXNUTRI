    {
        "id": "fn_validar",
        "type": "function",
        "z": "aba_mixnutri",
        "name": "Validar JSON",
        "func": "// Converte o texto em objeto e anota canal e tipo. Saida 1: valido; saida 2: invalido.\nmsg.texto = msg.payload;\nlet dados;\ntry {\n    dados = JSON.parse(msg.payload);\n} catch (e) {\n    msg.erro = 'json_invalido';\n    return [null, msg];\n}\nif (dados === null || typeof dados !== 'object' || Array.isArray(dados)) {\n    msg.erro = 'json_nao_e_objeto';\n    return [null, msg];\n}\nmsg.canal = msg.topic.split('/').pop();\nmsg.tipoEvento = msg.canal === 'eventos' ? String(dados.tipo || '') : '';\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 330,
        "y": 120,
        "wires": [
            [
                "sw_canal"
            ],
            [
                "fn_falha"
            ]
        ]
    },
